{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "exclude": [".output", "node_modules", "playwright-report", "test-results"]
}
